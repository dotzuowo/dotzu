<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinBoost / Modulos de Windows" Width="1220" Height="850" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#1D1D1D" Foreground="#F2F1EF" FontFamily="Segoe UI">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>


<LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#242424" Offset="0"/><GradientStop Color="#171717" Offset="1"/></LinearGradientBrush>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#3E3E3E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#2F2F2F"/><Setter Property="Foreground" Value="#F2F1EF"/><Setter Property="BorderBrush" Value="#515151"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#59ACDF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1587CC"/><Setter Property="Foreground" Value="#101010"/><Setter Property="BorderBrush" Value="#399AD4"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F2F1EF"/><Setter Property="Background" Value="#212121"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="32"/><Setter Property="MaxDropDownHeight" Value="340"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#242424" BorderBrush="#585858" BorderThickness="1" CornerRadius="6"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="10,3,27,3" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Stroke="#D4D4D4" StrokeThickness="1.6" Data="M0,0 L4,4 8,0" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#242424" BorderBrush="#787878" BorderThickness="1" CornerRadius="5" Padding="3"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F2F1EF"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#474747"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#4C4C4C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,0,15" Padding="18"><DockPanel><Grid DockPanel.Dock="Right" Margin="15,0,0,0"><Image Source="{DynamicResource WinBoostOriginalLogo}" Width="49" Height="49" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="WinBoost"/></Grid><StackPanel><TextBlock Text="Módulos de Windows" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Prepara tu selección y revisa el plan antes de ejecutarlo. Las acciones asistidas abren controles de Windows." Foreground="#CACACA" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0"><TextBox x:Name="ActionSearch" Padding="10" Margin="0,0,12,0" Background="#232323" Foreground="White" BorderBrush="#434343" ToolTip="Buscar funciones"/><TextBlock IsHitTestVisible="False" Margin="13,0,25,0" VerticalAlignment="Center" Text="Buscar por nombre o función…" Foreground="#B9B9B9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=ActionSearch,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="ActionCategory" Grid.Column="1" Padding="9" Foreground="#F2F1EF" Margin="0,0,12,0"/><Button x:Name="ActionReset" Grid.Column="2" Content="Limpiar selección"/></Grid>
  <DataGrid x:Name="ActionGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Background="#1F1F1F" Foreground="#F2F1EF" RowBackground="#1F1F1F" AlternatingRowBackground="#272727" BorderBrush="#3D3D3D" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3D3D3D" RowHeight="48" SelectionMode="Single" EnableRowVirtualization="True">
   <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#3D3D3D"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#525252"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Módulo" Binding="{Binding Category}" IsReadOnly="True" Width="130"/>
    <DataGridTextColumn Header="Función" Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
    <DataGridTemplateColumn Header="Opción" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="#F2F1EF" VerticalAlignment="Center" Padding="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Argumento (si se requiere)" Binding="{Binding Argument,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="195"/>
    <DataGridTextColumn Header="Recuperación / flujo" Binding="{Binding Route}" IsReadOnly="True" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="3" Background="#272727" CornerRadius="10" Padding="15" Margin="0,12,0,12"><TextBlock x:Name="ActionDetail" MinHeight="60" Text="Selecciona una fila para revisar alcance, requisitos y posibles efectos. Las funciones asistidas abren controles de Windows; no aplican el cambio por ti." Foreground="#CACACA" FontSize="12"/></Border>
  <WrapPanel Grid.Row="4" Margin="0,0,0,12"><Button Margin="0,0,7,4" x:Name="ActionPreview" Content="Revisar plan"/><Button Margin="0,0,7,4" x:Name="ActionApply" Content="Ejecutar selección" Style="{StaticResource Primary}"/><Button x:Name="ActionRestore" Content="Restaurar última sesión de módulos"/><Button x:Name="ActionStop" Content="Detener" IsEnabled="False"/><Button x:Name="ActionReport" Content="Ver informe"/></WrapPanel>
  <StackPanel Grid.Row="5"><ProgressBar x:Name="ActionProgress" Minimum="0" Maximum="100" Height="5" Foreground="#1587CC" Background="#353535" BorderThickness="0"/><TextBlock x:Name="ActionStatus" Text="Ninguna acción seleccionada se ejecuta hasta pulsar Ejecutar selección." Margin="0,10,0,14" Foreground="#B1B1B1" FontSize="12" MaxHeight="70"/></StackPanel>
  <DockPanel Grid.Row="6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ActionExport" Content="Guardar plan"/><Button x:Name="ActionImport" Content="Cargar plan"/><Button x:Name="ActionInventory" Content="Inventario de componentes"/></StackPanel><TextBlock Text="Las instalaciones y eliminaciones requieren reversión manual." Foreground="#BFA97D" FontSize="11" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
