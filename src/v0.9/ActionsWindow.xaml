<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinBoost / Modulos de Windows" Width="1220" Height="850" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#0B111B" Foreground="#EAF2FF" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#24476B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="WINBOOST / MODULOS DE WINDOWS" Foreground="#79B8FB" FontSize="11"/><TextBlock Text="Un plan. Cada cambio bajo tu control." FontSize="28" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="89 acciones automatizadas y 32 flujos asistidos. Elige opciones, comprueba el plan y ejecuta la secuencia. Sin cambios conserva el estado actual." Foreground="#9EB4CE"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ActionSearch" Padding="10" Margin="0,0,12,0" Background="#16253A" Foreground="White" BorderBrush="#304662" ToolTip="Buscar funciones"/><ComboBox x:Name="ActionCategory" Grid.Column="1" Padding="9" Foreground="#12243A" Margin="0,0,12,0"/><Button x:Name="ActionReset" Grid.Column="2" Content="Limpiar selección"/></Grid>
  <DataGrid x:Name="ActionGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Background="#132033" Foreground="#EAF2FF" RowBackground="#132033" AlternatingRowBackground="#19283B" BorderBrush="#2B405B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2B405B" RowHeight="48" SelectionMode="Single" EnableRowVirtualization="True">
   <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#24476B"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285A85"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Módulo" Binding="{Binding Category}" IsReadOnly="True" Width="130"/>
    <DataGridTextColumn Header="Función" Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
    <DataGridTemplateColumn Header="Opción" Width="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="#12243A" VerticalAlignment="Center" Padding="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Argumento (si se requiere)" Binding="{Binding Argument,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="195"/>
    <DataGridTextColumn Header="Recuperación / flujo" Binding="{Binding Route}" IsReadOnly="True" Width="150"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="3" Background="#162A42" CornerRadius="10" Padding="15" Margin="0,12,0,12"><TextBlock x:Name="ActionDetail" MinHeight="60" Text="Selecciona una fila para revisar alcance, requisitos y posibles efectos. Las funciones asistidas abren controles de Windows; no aplican el cambio por ti." Foreground="#B7CDE6" FontSize="12"/></Border>
  <WrapPanel Grid.Row="4" Margin="0,0,0,12"><Button x:Name="ActionPreview" Content="Revisar plan"/><Button x:Name="ActionApply" Content="Ejecutar selección" Background="#2585E1"/><Button x:Name="ActionRestore" Content="Restaurar última sesión de módulos"/><Button x:Name="ActionStop" Content="Detener" IsEnabled="False"/><Button x:Name="ActionReport" Content="Ver informe"/></WrapPanel>
  <StackPanel Grid.Row="5"><ProgressBar x:Name="ActionProgress" Minimum="0" Maximum="100" Height="5" Foreground="#55A6FF" Background="#273751" BorderThickness="0"/><TextBlock x:Name="ActionStatus" Text="Ninguna acción seleccionada se ejecuta hasta pulsar Ejecutar selección." Margin="0,10,0,14" Foreground="#9EB4CE" FontSize="12" MaxHeight="70"/></StackPanel>
  <DockPanel Grid.Row="6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ActionExport" Content="Guardar plan"/><Button x:Name="ActionImport" Content="Cargar plan"/><Button x:Name="ActionInventory" Content="Inventario de componentes"/></StackPanel><TextBlock Text="Las instalaciones y eliminaciones requieren reversión manual." Foreground="#BFA97D" FontSize="11" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
