<TextBlock x:Name="PlanSummary" Foreground="#A9BECE" FontSize="12"/><TextBlock x:Name="LongTasksNotice" Visibility="Collapsed" Text="Incluye tareas largas. Revisa Mantenimiento antes de aplicar." Foreground="#F0C488" FontSize="12" Margin="0,6,0,0"/>
