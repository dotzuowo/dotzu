<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinBoost Optimizer / 0.9" Width="1280" Height="830" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0B0F18" Foreground="#F0F4FC" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Window.Resources>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#131B29"/><Setter Property="BorderBrush" Value="#253047"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/></Style>
 <Style TargetType="Button"><Setter Property="Background" Value="#1D2A40"/><Setter Property="Foreground" Value="#F1F5FC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.36"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F0F4FC"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/><Border x:Name="Track" Grid.Column="1" Width="34" Height="20" Background="#35415A" CornerRadius="10"><Ellipse x:Name="Knob" Width="14" Height="14" Fill="#D6E4F5" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#398EF0"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid Margin="28,20,28,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border Width="42" Height="42" CornerRadius="13" Background="#2D80DD"><Viewbox Margin="11"><Path Fill="White" Data="M 13 0 L 2 13 L 9 13 L 5 23 L 20 8 L 12 8 Z"/></Viewbox></Border>
  <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="WINBOOST" FontSize="19" FontWeight="Bold"/><TextBlock Text="OPTIMIZER / 0.9" FontSize="10" Foreground="#8194B0"/></StackPanel>
  <Border Grid.Column="2" Background="#17243A" CornerRadius="14" Padding="13,7" VerticalAlignment="Center"><TextBlock Text="WINDOWS 11 · VERSIÓN DE PRUEBA" FontSize="10" FontWeight="SemiBold" Foreground="#9DB6D8"/></Border>
 </Grid>
 <WrapPanel Grid.Row="1" Margin="0,0,0,24"><Button x:Name="OpenActions" Content="Módulos de Windows" Background="#2585E1" Margin="0,0,8,0"/><Button x:Name="NavHome" Content="Resumen" Background="#204D7C" Margin="0,0,8,0"/><Button x:Name="NavModules" Content="Ajustes" Margin="0,0,8,0"/><Button x:Name="NavMaintenance" Content="Mantenimiento" Margin="0,0,8,0"/><Button x:Name="NavActivity" Content="Actividad" Margin="0,0,8,0"/><Button x:Name="NavRecovery" Content="Recuperación"/></WrapPanel>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0">
   <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Tu Windows. A tu manera." FontSize="29" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="Perfiles automáticos, ajustes individuales y recuperación en un solo lugar." Foreground="#91A5C2" Margin="0,0,0,23"/>
    <Border CornerRadius="19" Padding="26" BorderBrush="#345780" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B3D67" Offset="0"/><GradientStop Color="#152238" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel>
     <TextBlock Text="TU PERFIL DE OPTIMIZACIÓN" FontSize="10" FontWeight="Bold" Foreground="#8CC4FF"/>
     <ComboBox x:Name="Profile" SelectedIndex="0" Padding="11" FontSize="17" Foreground="#121C2B" Margin="0,14,0,14"><ComboBoxItem Content="Rápido"/><ComboBoxItem Content="Gaming"/><ComboBoxItem Content="Mantenimiento"/><ComboBoxItem Content="Personalizado"/></ComboBox>
     <TextBlock x:Name="ProfileDescription" Text="Preferencias de Windows. Sin instalaciones ni reparación." Foreground="#C4D5EB" LineHeight="21"/>
     <TextBlock x:Name="PlanSummary" Foreground="#86ABD1" FontSize="12" Margin="0,16,0,20"/>
     <Button x:Name="Optimize" Content="Aplicar optimización  →" Background="#3D91EF" FontSize="16" Padding="20,15"/>
     <TextBlock x:Name="LongTasksNotice" Visibility="Collapsed" Text="Tu selección incluye tareas largas. Revísalas en Mantenimiento." Foreground="#F0CA87" FontSize="12" Margin="0,13,0,0"/>
    </StackPanel></Border>
    <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Preview" Content="Ver plan sin aplicar"/><Button Grid.Column="2" x:Name="ShortcutSettings" Content="Explorar catálogo"/></Grid>
    <Border Style="{StaticResource Card}" Padding="18" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ESTE EQUIPO" FontSize="10" FontWeight="Bold" Foreground="#6DAFFF"/><TextBlock x:Name="HardwareText" Text="Consultando identificación local…" Margin="0,8,12,5" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="SystemText" Foreground="#8095B2" FontSize="11"/></StackPanel><Button Grid.Column="1" x:Name="RefreshHardware" Content="GPU / RAM" FontSize="11" VerticalAlignment="Center" Padding="12,9"/></Grid></Border>
    <WrapPanel Margin="0,17,0,0"><Button x:Name="ExportProfile" Content="Guardar perfil" Background="Transparent" FontSize="11"/><Button x:Name="ImportProfile" Content="Cargar perfil" Background="Transparent" FontSize="11"/></WrapPanel>
   </StackPanel></ScrollViewer>
   <ScrollViewer x:Name="ModulesPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel>
    <TextBlock Text="Lo que cambia en tu PC." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Activa lo que necesitas. Los cambios se aplican al ejecutar desde Resumen." Foreground="#91A5C2" Margin="0,8,0,22"/>
    <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptPrivacy" Content="Privacidad e interfaz"/><TextBlock Text="Publicidad, recomendaciones e interfaz. Revisa las preferencias individuales antes de aplicar." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptCaptures" Content="Juegos y capturas"/><TextBlock Text="Capturas Xbox y Modo Juego opcional. Selecciona cada preferencia en el catálogo." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptPower" Content="Energía"/><TextBlock Text="Alto rendimiento solo con corriente y si el plan existe. Puede elevar consumo y temperatura." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptStartup" Content="Inicio ligero"/><TextBlock Text="Quita entradas de Discord, Steam, Epic y Spotify en Run del usuario. No cierra las apps." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptMouse" Content="Puntero"/><TextBlock Text="Desactiva aceleración del puntero del escritorio. Los juegos con entrada directa pueden ignorarlo." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptApps" Content="Apps opcionales"/><TextBlock Text="Quita seis apps si existen. Puede borrar sus datos locales; reinstalación manual desde Store." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border></UniformGrid><Button x:Name="ChooseSettings" Content="Explorar ajustes de WinBoost" Background="#22466D" Margin="0,6,12,10"/></StackPanel></ScrollViewer>
   <ScrollViewer x:Name="MaintenancePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel><TextBlock Text="Mantenimiento, cuando lo necesites." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Estas tareas van aparte del perfil Rápido. Las instalaciones y reparaciones pueden tardar varios minutos." Foreground="#91A5C2" Margin="0,8,0,22"/><UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptCleanup" Content="Temporales antiguos"/><TextBlock Text="Elimina archivos temporales sin uso durante 7 días, hasta 1 GB. No se recuperan al restaurar." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptDeepInventory" Content="Diagnóstico ampliado"/><TextBlock Text="Consulta GPU, RAM, inicio y red. Es más lento; los datos estáticos se reutilizan en el estado final." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptRuntimes" Content="Runtimes Microsoft"/><TextBlock Text="Instala VC++ x64/x86 y .NET 8/10. Requiere internet, acepta licencias y puede solicitar permisos." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptRepair" Content="Reparar Windows"/><TextBlock Text="DISM y SFC. Puede tardar varios minutos y pedir permisos. Las reparaciones no se revierten." Foreground="#96A8C3" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border></UniformGrid><Border Background="#272235" Padding="17" CornerRadius="12" Margin="0,4,12,0"><TextBlock Text="Se ejecutan en la misma secuencia al pulsar Aplicar desde Resumen. La detención espera a que termine el instalador o reparación en curso." Foreground="#C7B7D5" FontSize="12"/></Border></StackPanel></ScrollViewer>
   <Grid x:Name="ActivityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="Cada acción, a la vista." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Registro de esta ejecución. El informe conserva tareas, tiempos y resultados." Foreground="#91A5C2" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="14"><TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#AFC8E6" BorderThickness="0" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/></Border><WrapPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="OpenReport" Content="Abrir informe" Margin="0,0,12,0"/><Button x:Name="OpenSession" Content="Archivos de la sesión"/></WrapPanel></Grid>
   <ScrollViewer x:Name="RecoveryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Vuelve a tu configuración." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Restaura la última sesión pendiente. Los cambios externos se conservan y se registran como conflictos." Foreground="#91A5C2" Margin="0,8,0,20"/><Button x:Name="Restore" Content="Restaurar preferencias, inicio y energía" Background="#22466D"/><TextBlock Text="No recupera temporales eliminados, datos de apps, instalaciones ni reparaciones. Conserva compatibilidad con respaldos 0.3 y 0.4." Foreground="#BFA97D" FontSize="12" Margin="0,12,0,22"/><TextBlock Text="SESIONES RECIENTES" FontSize="10" Foreground="#7DA7D4" FontWeight="Bold"/><ListBox x:Name="HistoryList" Height="205" Margin="0,12,0,15" Background="#131B29" Foreground="#BCD0E9" BorderBrush="#253047" DisplayMemberPath="Title"/><WrapPanel><Button x:Name="RefreshHistory" Content="Actualizar" Margin="0,0,10,10"/><Button x:Name="OpenHistory" Content="Abrir selección" Margin="0,0,10,10"/><Button x:Name="OpenData" Content="Todos los respaldos" Margin="0,0,0,10"/></WrapPanel></StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="EJECUCIÓN" FontSize="10" Foreground="#7B9CC5" FontWeight="Bold"/><TextBlock x:Name="Elapsed" Grid.Column="1" Text="00:00:00" FontFamily="Consolas" FontSize="11" Foreground="#8DA6C8"/></Grid>
   <StackPanel Grid.Row="1" Margin="0,22,0,0"><TextBlock x:Name="RunTitle" Text="Listo para empezar." FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="RunDetail" Text="El perfil Rápido no instala ni repara Windows." Foreground="#8FA5C2" FontSize="12" LineHeight="18" Margin="0,12,0,0"/></StackPanel>
   <ProgressBar x:Name="Progress" Grid.Row="2" Minimum="0" Maximum="100" Value="0" Height="5" Foreground="#55A6FF" Background="#273751" BorderThickness="0" Margin="0,23,0,23"/>
   <ListBox x:Name="StageList" Grid.Row="3" Background="Transparent" Foreground="#AAC2E0" BorderThickness="0" FontSize="12" DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle></ListBox>
   <StackPanel Grid.Row="4"><Button x:Name="StopRun" Content="Detener al terminar la tarea actual" IsEnabled="False" FontSize="11" Padding="12,11"/><TextBlock Text="Las preferencias originales se guardan antes de aplicar los cambios." FontSize="10" Foreground="#607B9F" TextAlignment="Center" Margin="0,16,0,0"/></StackPanel>
  </Grid></Border>
 </Grid>
 <Grid Grid.Row="3" Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CONTROL LOCAL · SIN ENVÍO DE INFORMES" FontSize="9" Foreground="#526A8C"/><TextBlock Grid.Column="1" Text="0.9 / WINBOOST" FontSize="9" Foreground="#526A8C"/></Grid>
</Grid></Window>