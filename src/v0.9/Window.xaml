<TextBlock x:Name="PlanSummary" Foreground="#BBBBBB" FontSize="12"/><TextBlock x:Name="LongTasksNotice" Visibility="Collapsed" Text="Incluye tareas largas. Revisa Mantenimiento antes de aplicar." Foreground="#F0C488" FontSize="12" Margin="0,6,0,0"/>
<WrapPanel Margin="0,15,0,0"><Button x:Name="Optimize" Style="{StaticResource Primary}" Content="Aplicar optimización" Margin="0,0,8,4"/><Button x:Name="Preview" Content="Revisar plan" Margin="0,0,0,4"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,12,0,0"><DockPanel><Button x:Name="RefreshHardware" DockPanel.Dock="Right" VerticalAlignment="Center" Content="GPU / RAM" FontSize="12"/><StackPanel Margin="0,0,8,0"><TextBlock Text="Este equipo" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="HardwareText" Text="Consultando equipo…" Foreground="#DDDDDD" FontSize="13" Margin="0,5,0,0"/><TextBlock x:Name="SystemText" Foreground="#B1B1B1" FontSize="12"/></StackPanel></DockPanel></Border>
<WrapPanel Margin="0,12,0,0"><Button x:Name="ShortcutSettings" Content="Catálogo de ajustes" Margin="0,0,7,5"/><Button x:Name="ExportProfile" Content="Guardar perfil" Margin="0,0,7,5"/><Button x:Name="ImportProfile" Content="Cargar perfil" Margin="0,0,0,5"/></WrapPanel>
</StackPanel></ScrollViewer><ScrollViewer x:Name="ModulesPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel>
    <TextBlock Text="Ajustes de Windows" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Activa lo que necesitas. Los cambios se aplican al ejecutar desde Resumen." Foreground="#A3A3A3" Margin="0,8,0,22"/>
    <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptPrivacy" Content="Privacidad e interfaz"/><TextBlock Text="Publicidad, recomendaciones e interfaz. Revisa las preferencias individuales antes de aplicar." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptCaptures" Content="Juegos y capturas"/><TextBlock Text="Capturas Xbox y Modo Juego opcional. Selecciona cada preferencia en el catálogo." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptPower" Content="Energía"/><TextBlock Text="Alto rendimiento solo con corriente y si el plan existe. Puede elevar consumo y temperatura." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptStartup" Content="Inicio ligero"/><TextBlock Text="Quita entradas de Discord, Steam, Epic y Spotify en Run del usuario. No cierra las apps." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptMouse" Content="Puntero"/><TextBlock Text="Desactiva aceleración del puntero del escritorio. Los juegos con entrada directa pueden ignorarlo." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptApps" Content="Apps opcionales"/><TextBlock Text="Quita seis apps si existen. Puede borrar sus datos locales; reinstalación manual desde Store." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border></UniformGrid><Button x:Name="ChooseSettings" Content="Explorar ajustes de WinBoost" Background="#414141" Margin="0,6,12,10"/></StackPanel></ScrollViewer>
   <ScrollViewer x:Name="MaintenancePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel><TextBlock Text="Mantenimiento" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Estas tareas van aparte del perfil Rápido. Las instalaciones y reparaciones pueden tardar varios minutos." Foreground="#A3A3A3" Margin="0,8,0,22"/><UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptCleanup" Content="Temporales antiguos"/><TextBlock Text="Elimina archivos temporales sin uso durante 7 días, hasta 1 GB. No se recuperan al restaurar." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptDeepInventory" Content="Diagnóstico ampliado"/><TextBlock Text="Consulta GPU, RAM, inicio y red. Es más lento; los datos estáticos se reutilizan en el estado final." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptRuntimes" Content="Runtimes Microsoft"/><TextBlock Text="Instala VC++ x64/x86 y .NET 8/10. Requiere internet, acepta licencias y puede solicitar permisos." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="17"><StackPanel><CheckBox x:Name="OptRepair" Content="Reparar Windows"/><TextBlock Text="DISM y SFC. Puede tardar varios minutos y pedir permisos. Las reparaciones no se revierten." Foreground="#A6A6A6" FontSize="12" Margin="0,12,0,0" LineHeight="18"/></StackPanel></Border></UniformGrid><Border Background="#242424" Padding="17" CornerRadius="12" Margin="0,4,12,0"><TextBlock Text="Se ejecutan en la misma secuencia al pulsar Aplicar desde Resumen. La detención espera a que termine el instalador o reparación en curso." Foreground="#BDBDBD" FontSize="12"/></Border></StackPanel></ScrollViewer>
   <Grid x:Name="ActivityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="Registro de actividad" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Registro de esta ejecución. El informe conserva tareas, tiempos y resultados." Foreground="#A3A3A3" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="14"><TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="#C5C5C5" BorderThickness="0" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/></Border><WrapPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="OpenReport" Content="Abrir informe" Margin="0,0,12,0"/><Button x:Name="OpenSession" Content="Archivos de la sesión"/></WrapPanel></Grid>
   <ScrollViewer x:Name="RecoveryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Recuperación" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Restaura la última sesión pendiente. Los cambios externos se conservan y se registran como conflictos." Foreground="#A3A3A3" Margin="0,8,0,20"/><Button x:Name="Restore" Content="Restaurar preferencias, inicio y energía" Background="#414141"/><TextBlock Text="No recupera temporales eliminados, datos de apps, instalaciones ni reparaciones. Conserva compatibilidad con respaldos 0.3 y 0.4." Foreground="#BFA97D" FontSize="12" Margin="0,12,0,22"/><TextBlock Text="SESIONES RECIENTES" FontSize="10" Foreground="#A1A1A1" FontWeight="Bold"/><ListBox x:Name="HistoryList" Height="205" Margin="0,12,0,15" Background="#1A1A1A" Foreground="#CECECE" BorderBrush="#2F2F2F" DisplayMemberPath="Title"/><WrapPanel><Button x:Name="RefreshHistory" Content="Actualizar" Margin="0,0,10,10"/><Button x:Name="OpenHistory" Content="Abrir selección" Margin="0,0,10,10"/><Button x:Name="OpenData" Content="Todos los respaldos" Margin="0,0,0,10"/></WrapPanel></StackPanel></ScrollViewer></Grid>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
