<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinBoost / Centro de ajustes" Width="1120" Height="760" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#0B111B" Foreground="#EAF2FF" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#24476B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="WINBOOST / CENTRO DE AJUSTES" Foreground="#79B8FB" FontSize="11"/><TextBlock Text="Configura Windows a tu manera." FontSize="28" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Explora las categorías y consulta qué cambia cada opción. Se aplicarán las marcadas cuyos módulos estén activos en la pantalla principal." Foreground="#9EB4CE"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBox x:Name="SearchSettings" Margin="0,0,12,0" Padding="11" Background="#16253A" Foreground="#EAF2FF" BorderBrush="#304662" ToolTip="Buscar por nombre, descripción o módulo"/><ComboBox x:Name="CategoryFilter" Grid.Column="1" Padding="10" Foreground="#12243A"/></Grid>
  <DockPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock x:Name="CountSettings" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8FA6C2"/><StackPanel Orientation="Horizontal"><Button x:Name="SelectVisible" Content="Marcar visibles"/><Button x:Name="ClearVisible" Content="Desmarcar visibles"/><Button x:Name="DefaultSettings" Content="Selección base"/></StackPanel></DockPanel>
  <DataGrid x:Name="SettingsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Background="#132033" Foreground="#EAF2FF" RowBackground="#132033" AlternatingRowBackground="#19283B" BorderBrush="#2B405B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2B405B" RowHeight="44" SelectionMode="Single" EnableRowVirtualization="True">
   <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#24476B"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285A85"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
   <DataGrid.Columns><DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="64"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" IsReadOnly="True" Width="165"/><DataGridTextColumn Header="Ajuste" Binding="{Binding Label}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Actual" Binding="{Binding Current}" IsReadOnly="True" Width="115"/><DataGridTextColumn Header="Objetivo" Binding="{Binding Target}" IsReadOnly="True" Width="80"/></DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="4" Background="#162A42" CornerRadius="10" Padding="16" Margin="0,14,0,14"><TextBlock x:Name="DetailText" MinHeight="64" Text="Selecciona una fila para consultar su descripción, el módulo necesario y los valores." Foreground="#B7CDE6" FontSize="12"/></Border>
  <DockPanel Grid.Row="5"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelSettings" Content="Cancelar"/><Button x:Name="SaveSettings" Content="Guardar selección" Background="#2585E1"/></StackPanel><TextBlock Text="Respaldo de valores originales antes de aplicar." VerticalAlignment="Center" Foreground="#8FA6C2" FontSize="12"/></DockPanel>
 </Grid>
</Window>
